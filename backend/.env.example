# --- SERVER CONFIG ---
# Aplikasi membaca env "PORT", bukan "HTTP_PORT".
# Default di kode adalah 8080 jika kosong.
APP_ENV=dev
PORT=8080

# --- DATABASE CONFIG ---
# Format: postgres://username:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://user:password@localhost:5432/mutabaah_db?sslmode=disable

# --- MIGRATIONS ---
RUN_MIGRATIONS=true
MIGRATIONS_DIR=migrations

# --- AUTH & SECURITY ---
# Ganti dengan string acak yang panjang dan aman
JWT_SECRET=change_this_to_a_secure_random_secret
# Durasi token dalam menit (contoh: 43200 menit = 30 hari)
JWT_TTL_MINUTES=43200

# --- DB POOL SETTINGS (Optional/Advanced) ---
# Pengaturan koneksi database untuk performa
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MIN=60
DB_CONN_MAX_IDLE_TIME_MIN=10

# --- LOGGING ---
LOG_LEVEL=debug
LOG_PRETTY=true

# --- FRONTEND CONFIG ---
# URL Backend (Diperlukan oleh Frontend Vue.js)
VITE_API_BASE_URL=http://localhost:8080/api/v1